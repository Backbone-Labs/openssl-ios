# The OpenSSL release this package builds. Sourced by scripts/build-xcframework.sh
# and the release workflow, so a version bump is a change to this file only.
#
# OPENSSL_SHA256 must be the digest OpenSSL publishes for the tarball. Read it from
# the release itself rather than computing it over a download:
#   gh api repos/openssl/openssl/releases/tags/openssl-<version> \
#     --jq '.assets[] | select(.name|endswith(".tar.gz")) | .digest'
#
# Stay on an LTS line (3.5 is supported until 2030-04-08).
OPENSSL_VERSION=3.5.7
OPENSSL_SHA256=a8c0d28a529ca480f9f36cf5792e2cd21984552a3c8e4aa11a24aa31aeac98e8

# Match the consuming apps' deployment targets (Backbone iOS, fuji-tvos).
# Raising either is a breaking change for any consumer still on the older OS.
IOS_DEPLOYMENT_TARGET=17.0
TVOS_DEPLOYMENT_TARGET=17.0
